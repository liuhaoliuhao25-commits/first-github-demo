---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import PostCard from '../../../components/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { slug: tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;

const posts = (
  await getCollection('blog', ({ data }) => !data.draft && data.tags.includes(tag))
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base
  title={`标签 · ${tag}`}
  description={`「${tag}」标签下的全部文章，共 ${posts.length} 篇。`}
>
  <section class="page-head section-sm">
    <div class="container">
      <p class="kicker" data-hero>Tag</p>
      <h1 class="page-title" data-hero>#{tag}</h1>
      <p class="page-sub num" data-hero>共 {posts.length} 篇文章</p>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="post-grid post-list">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      <p class="list-back" data-reveal>
        <a class="btn" href="/blog/">← 返回全部文章</a>
      </p>
    </div>
  </section>
</Base>
