---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { formatDateLong, formatISO, readingMinutes } from '../../lib/utils';
import TableOfContents from '../../components/TableOfContents.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import BackToTop from '../../components/BackToTop.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const { title, description, pubDate, updatedDate, category, tags } = post.data;

const minutes = readingMinutes(post.body || '');
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const cover = post.data.cover || '/og.svg';
---

<Base title={title} description={description} type="article" image={cover}>
  <ReadingProgress />

  <article class="post">
    <!-- 标题区：刊头装饰线 + 日期艺术化排版 -->
    <header class="post-header section-sm">
      <div class="container-narrow">
        <p class="masthead-rule" data-hero>{category}</p>
        <h1 class="post-title" data-hero>{title}</h1>
        <p class="post-desc" data-hero>{description}</p>
        <div class="post-meta num" data-hero>
          <time datetime={formatISO(pubDate)}>{formatDateLong(pubDate)}</time>
          {updatedDate && <span>· 更新于 {formatDateLong(updatedDate)}</span>}
          <span class="dot">·</span>
          <span>约 {minutes} 分钟读完</span>
        </div>
        <div class="post-tags" data-hero>
          <a class="badge" href={`/blog/category/${encodeURIComponent(category)}/`}>
            {category}
          </a>
          {tags.map((t) => (
            <a class="badge" href={`/blog/tag/${encodeURIComponent(t)}/`}>
              #{t}
            </a>
          ))}
        </div>
      </div>
    </header>

    <div class="post-layout">
      <div class="post-main">
        <!-- 移动端目录（<details> 原生折叠，无 JS 也可用） -->
        <details class="toc-mobile">
          <summary>目录</summary>
          <TableOfContents headings={toc} />
        </details>

        <div class="prose">
          <Content />
        </div>
      </div>

      <!-- 桌面端侧边目录（sticky + 锚点高亮） -->
      <aside class="post-aside" aria-label="文章目录">
        <div class="toc-sticky">
          <TableOfContents headings={toc} />
        </div>
      </aside>
    </div>
  </article>

  <BackToTop />
</Base>
