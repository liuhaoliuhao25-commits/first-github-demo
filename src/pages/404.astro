---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
---

<Base title={`页面未找到 · ${SITE.title}`} description="你访问的页面不存在或已被移动。" noIndex>
  <section class="notfound">
    <div class="container-narrow">
      <p class="kicker" data-hero>404</p>
      <h1 class="page-title" data-hero>页面未找到</h1>
      <p class="page-sub" data-hero>你访问的页面不存在，或已被移动。</p>
      <p class="notfound-action" data-hero>
        <a class="btn" href="/">← 回到首页</a>
      </p>
    </div>
  </section>
</Base>
