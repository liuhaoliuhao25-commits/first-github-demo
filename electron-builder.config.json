{
  "appId": "com.monkeycode.pet-desktop",
  "productName": "AI 桌宠",
  "version": "1.0.0",
  "description": "基于本地 AI 的独有桌宠应用",
  "author": "MonkeyCode",
  "copyright": "Copyright © 2026 MonkeyCode",
  
  "build": {
    "productName": "AI 桌宠",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    
    "files": [
      "dist/**/*",
      "electron/main/**/*",
      "package.json",
      "!node_modules/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme,test,__tests__,tests,perf,benchmarks,example,examples,typing,typings,*.d.ts}",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,h,li,a,so,exp,lock}"
    ],
    
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    
    "asar": true,
    "asarUnpack": ["**/*.node"],
    
    "compression": "maximum",
    
    "publish": [
      {
        "provider": "github",
        "owner": "liuhaoliuhao25-commits",
        "repo": "first-github-demo",
        "releaseType": "release",
        "private": false
      }
    ],
    
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI 桌宠",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "license": "LICENSE",
      "installerLanguages": ["zh_CN"],
      "language": "2052:00000804",
      "deleteAppDataOnUninstall": true
    },
    
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.entertainment",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": null,
      "notarize": false
    },
    
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Utility",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "maintainer": "MonkeyCode",
      "desktop": {
        "Name": "AI 桌宠",
        "Comment": "基于本地 AI 的独有桌宠应用",
        "Categories": "Utility;Entertainment"
      }
    },
    
    "appImage": {
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    
    "deb": {
      "depends": ["gconf2", "gconf-service", "libnotify4", "libappindicator1", "libxtst6", "libnss3"],
      "dependsOptional": ["libsecret-1-0"]
    }
  },
  
  "electronUpdater": {
    "autoInstall": true,
    "autoRunTaskAfter": {
      "name": "quitAndInstall",
      "initialDelay": 3000
    },
    "provider": "github",
    "owner": "liuhaoliuhao25-commits",
    "repo": "first-github-demo"
  }
}
